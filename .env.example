CTP_ACCOUNT_PROFILE=openctp-tts-7x24-simulation

# OpenCTP TTS 7x24 simulation account. Used for 24h API development/debug evidence.
OPENCTP_TTS_7X24_USER_ID=
OPENCTP_TTS_7X24_PASSWORD=
OPENCTP_TTS_API_ROOT=output/openctp/ctpapi-python-win64
OPENCTP_TTS_CONFIG=cfgs/local/ctp.openctp.tts.7x24.local.json

# Optional OpenCTP simenv / simulation account. Use only when a task explicitly
# needs the OpenCTP 仿真环境 rather than the 7x24 replay/debug environment.
OPENCTP_SIMENV_USER_ID=
OPENCTP_SIMENV_PASSWORD=
OPENCTP_SIMENV_CONFIG=cfgs/local/ctp.openctp.simenv.local.json

# Optional broker paper/simulation account from a futures company or broker.
# Use for broker-specific dry-run validation, not for 24h API debugging.
CTP_BROKER_PAPER_BROKER_ID=
CTP_BROKER_PAPER_USER_ID=
CTP_BROKER_PAPER_PASSWORD=
CTP_BROKER_PAPER_TD_FRONT=
CTP_BROKER_PAPER_MD_FRONT=
CTP_BROKER_PAPER_CONFIG=cfgs/local/ctp.broker.paper.local.json

# Formal broker / trading account. Used only for final broker-facing evidence.
CTP_FORMAL_BROKER_ID=
CTP_FORMAL_USER_ID=
CTP_FORMAL_PASSWORD=
CTP_FORMAL_PRODUCT_INFO=
CTP_FORMAL_APP_ID=
CTP_FORMAL_AUTH_CODE=
CTP_FORMAL_TD_FRONT=
CTP_FORMAL_MD_FRONT=
CTP_FORMAL_CONFIG=cfgs/local/ctp.live.formal.local.json
