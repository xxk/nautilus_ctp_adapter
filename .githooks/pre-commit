#!/bin/sh
set -eu

SCRIPT="D:/Nautilus/global_docs/scripts/check_owner_side_blocker_repair_adoption.py"
MANIFEST="D:/Nautilus/global_docs/harness/owner_side_blocker_repair_adopters.json"
TEST_CONTRACT_SCRIPT="D:/Nautilus/global_docs/scripts/check_test_contract_authority_adoption.py"
WORKTREE_LAYOUT_SCRIPT="D:/Nautilus/global_docs/scripts/check_codex_worktree_layout.py"
ADR_LANG_SCRIPT="D:/Nautilus/global_docs/scripts/check_adr_filename_language.py"

if command -v python >/dev/null 2>&1; then
  python "$SCRIPT" --manifest "$MANIFEST"
  python "$TEST_CONTRACT_SCRIPT" --check-hooks
  python "$WORKTREE_LAYOUT_SCRIPT" --repo .
  python "$ADR_LANG_SCRIPT" --staged
elif command -v py >/dev/null 2>&1; then
  py -3 "$SCRIPT" --manifest "$MANIFEST"
  py -3 "$TEST_CONTRACT_SCRIPT" --check-hooks
  py -3 "$WORKTREE_LAYOUT_SCRIPT" --repo .
  py -3 "$ADR_LANG_SCRIPT" --staged
else
  echo "OWNER_SIDE_BLOCKER_REPAIR_ADOPTION_FAILED"
  echo "- python is required to run global docs commit gates"
  exit 1
fi
